<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.codex.math.history-companion</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/USER_NAME/Library/Application Support/Codex Math History Companion/manage.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>StandardOutPath</key>
  <string>/Users/USER_NAME/Library/Application Support/Codex Math History Companion/manager.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/USER_NAME/Library/Application Support/Codex Math History Companion/manager.err.log</string>
</dict>
</plist>
